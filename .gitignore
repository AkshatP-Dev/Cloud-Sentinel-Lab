# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Real values — never commit these. terraform.tfvars.example (checked in)
# is the template; terraform.tfvars (gitignored) is your own copy.
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Deliberately NOT ignored: .terraform.lock.hcl — this is meant to be
# committed so provider versions are reproducible across machines.

# Lambda build artifacts — regenerated by `terraform apply` via
# data.archive_file (see terraform/modules/detection/main.tf); the source
# in lambda/ is what's tracked, not the zip Terraform builds from it.
terraform/modules/detection/build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local environment — .env.example (checked in) is the template.
.env
.env.local

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.venv/
.venv-test/
